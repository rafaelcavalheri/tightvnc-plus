<?xml version="1.0" encoding="utf-8"?>
<Include>
  <?define ProductNameStub='TightVNC' ?>
  <?define Language='1033' ?>
  <?define Codepage='1252' ?>
  <?define StartProductVersion='2.0.0' ?> <!-- Earlest version that can be upgraded by this installer -->
  <!-- WARNING! If Version number increase is forget in a release
       then the installer will
       install the TightVNC product parallelly with the same version and
       the same name -->
  <!-- BuildRevision is passed from build-and-package.bat (via make-msi.bat's
       arbitrary -d define argument) so every generated MSI gets a strictly
       increasing version. Without this, reinstalling an MSI with the exact
       same ProductVersion as one already on the machine is blocked by the
       AlreadyUpdated custom action (see custom_actions.wxs), and silently
       does nothing: the old binaries stay in place. -->
  <?ifndef BuildRevision ?>
    <?define BuildRevision = '81' ?>
  <?endif?>
  <?define Version = "2.8.$(var.BuildRevision)" ?>
  <?define Manufacturer='GlavSoft LLC.' ?>

  <?define SrcFolder = "..\" ?>

  <!-- This name must be synchronized to the source code name -->
  <?define AllUsersProgramDataFolderName = "$(var.ProductNameStub)"?>

  <?define UpgradeCode='B1F272B0-5B47-46f0-9AF2-705E64EB1A69' ?>
  <?define ProductName = "$(var.ProductNameStub)" ?>
  
  <?if $(var.Platform) = x64 ?>
    <?define ProductId = '*' ?>
    <?define Win64 = "yes" ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
    <?define BinFolder = "$(var.SrcFolder)\Release\x64" ?>
    <?define AddonBinFolder = "files64" ?>
  <?else ?>
    <?define ProductId = '*' ?>
    <?define Win64 = "no" ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
    <?define BinFolder = "$(var.SrcFolder)\Release\x86" ?>
    <?define AddonBinFolder = "files32" ?>
  <?endif ?>
</Include>
